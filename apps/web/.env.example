# Local development. Production builds always use /api (same-origin proxy).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# Server-side Next.js /api rewrite target. Required as an exact HTTPS origin
# for production builds; never use NEXT_PUBLIC_API_BASE_URL for secrets.
ORDERLY_API_ORIGIN=http://localhost:4000

# Server-only shared secret, independently generated and also set on Railway.
# Required for production /api client identity signing; at least 32 UTF-8 bytes.
# ORDERLY_PROXY_IDENTITY_SECRET=generate-a-random-secret-outside-this-repository
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=false
