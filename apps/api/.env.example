DATABASE_URL="postgresql://orderly_user:orderly_password@localhost:5432/orderly_db?schema=public"
DIRECT_DATABASE_URL="postgresql://orderly_user:orderly_password@localhost:5432/orderly_db?schema=public"
TEST_DATABASE_URL="postgresql://orderly_user:orderly_password@localhost:5432/orderly_test?schema=public"
WEB_ORIGIN=http://localhost:3000
API_PORT=4000

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_DAYS=7

# Customer secrets must be independently generated, at least 32 characters,
# and different from both Admin secrets. Required when starting the API.
CUSTOMER_JWT_ACCESS_SECRET=replace-with-an-independent-customer-access-secret
CUSTOMER_JWT_REFRESH_SECRET=replace-with-an-independent-customer-refresh-secret
CUSTOMER_JWT_ISSUER=orderly-customer
CUSTOMER_JWT_AUDIENCE=orderly-customer-api
CUSTOMER_JWT_ACCESS_TTL=15m
CUSTOMER_JWT_REFRESH_TTL=7d
CUSTOMER_SESSION_ABSOLUTE_TTL=30d

# Set the same independent, high-entropy value on Railway and Vercel.
# Required for production signed client-IP throttling; at least 32 UTF-8 bytes.
# ORDERLY_PROXY_IDENTITY_SECRET=generate-a-random-secret-outside-this-repository

# Optional Google OIDC. Supply all three values together to enable it.
# Register this exact HTTPS URL as an authorized redirect URI in Google Console.
# It must use WEB_ORIGIN, not the Railway API hostname.
# GOOGLE_CLIENT_ID=your-google-web-client-id
# GOOGLE_CLIENT_SECRET=your-google-web-client-secret
# GOOGLE_CALLBACK_URL=https://your-web-origin.example/api/customer/auth/google/callback

ADMIN_SEED_EMAIL=admin@orderly.local
ADMIN_SEED_PASSWORD=use-a-long-unique-local-password

# Optional AI description drafts. Set both on the API, and enable the web's
# NEXT_PUBLIC_AI_ASSISTANT_ENABLED flag only when this provider is configured.
OPENAI_API_KEY=""
OPENAI_MODEL=""
