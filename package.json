{
  "name": "orderly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter api exec prisma migrate dev",
    "db:generate": "pnpm --filter api exec prisma generate",
    "db:seed": "pnpm --filter api exec prisma db seed",
    "db:reset": "pnpm --filter api exec prisma migrate reset",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r test",
    "test:api:unit": "pnpm --filter api test:unit",
    "test:api:e2e": "pnpm --filter api test:e2e",
    "test:web": "pnpm --filter web test",
    "test:browser": "pnpm --filter web test:e2e",
    "test:quality": "pnpm --filter api test:quality && pnpm --filter web test:quality && pnpm test:browser"
  },
  "packageManager": "pnpm@10.14.0"
}
